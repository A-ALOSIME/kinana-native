import { Theme } from "../theme.slint";

export component KinanaButton {
    in property <string> text: "زر";
    in property <string> variant: "primary"; // "primary" (white), "green", "secondary", "danger", "ghost"
    in property <bool> enabled: true;
    in property <length> custom-font-size: 14px;
    in property <length> custom-height: 44px;
    in property <length> border-radius: 12px;
    
    callback clicked();

    min-height: root.custom-height;
    horizontal-stretch: 0;

    rect := Rectangle {
        border-radius: root.border-radius;
        background: !root.enabled ? #181920 :
            touch.pressed ? (
                root.variant == "primary" ? #e4e4e7 :
                root.variant == "green" ? #059669 :
                root.variant == "danger" ? #991b1b :
                root.variant == "secondary" ? #252834 : #1c1e27
            ) :
            touch.has-hover ? (
                root.variant == "primary" ? #f4f4f5 :
                root.variant == "green" ? #059669 :
                root.variant == "danger" ? #b91c1c :
                root.variant == "secondary" ? #1f222d : #181a22
            ) : (
                root.variant == "primary" ? #ffffff :
                root.variant == "green" ? #10b981 :
                root.variant == "danger" ? #dc2626 :
                root.variant == "secondary" ? #161820 : transparent
            );

        border-width: (root.variant == "secondary" || root.variant == "ghost") ? 1px : 0px;
        border-color: (root.variant == "secondary") ? Theme.border : (touch.has-hover ? Theme.border-light : transparent);

        animate background { duration: 120ms; }
        animate border-color { duration: 120ms; }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: center;
            spacing: 8px;

            Text {
                text: root.text;
                color: !root.enabled ? Theme.text-muted :
                    (root.variant == "primary" ? #000000 :
                     root.variant == "green" ? #ffffff :
                     root.variant == "danger" ? #ffffff :
                     root.variant == "ghost" ? (touch.has-hover ? Theme.text-primary : Theme.text-secondary) :
                     Theme.text-primary);
                font-family: Theme.font-family;
                font-size: root.custom-font-size;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => {
                root.clicked();
            }
            mouse-cursor: root.enabled ? pointer : default;
        }
    }
}
