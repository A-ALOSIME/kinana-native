import { Theme } from "../theme.slint";

export component KinanaModal {
    in property <string> title: "";
    in property <length> modal-width: 680px;
    in property <length> modal-height: 580px;
    in property <length> modal-max-height: 720px;
    callback close();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // Dim background overlay covering the entire window
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.transparentize(0.35);

        // Clicking anywhere outside the modal card closes the modal!
        TouchArea {
            clicked => {
                root.close();
            }
        }
    }

    // Modal Box Centered
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: root.modal-width;
                max-height: root.modal-max-height;
                border-radius: 20px;
                background: #0a0b0e;
                border-width: 1px;
                border-color: #1f2128;
                clip: true;

                // Stop backdrop clicks inside modal card from closing the modal
                TouchArea {}

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    // Header row
                    HorizontalLayout {
                        alignment: space-between;

                        // Close button X on top left
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: close-touch.has-hover ? #20222a : transparent;

                            Image {
                                source: @image-url("../assets/icons/x.svg");
                                width: 14px;
                                height: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            close-touch := TouchArea {
                                clicked => {
                                    root.close();
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        if root.title != "": Text {
                            text: root.title;
                            color: #ffffff;
                            font-family: Theme.font-family;
                            font-size: 20px;
                            font-weight: 800;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }

                    @children
                }
            }
        }
    }
}
