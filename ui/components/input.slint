import { Theme } from "../theme.slint";

export component KinanaInput {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <string> label: "";
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <length> custom-height: 44px;
    in property <length> border-radius: 12px;
    in property <length> font-size: 14px;
    in property <TextHorizontalAlignment> text-align: right;
    in property <InputType> input-type: password ? InputType.password : InputType.text;
    
    callback accepted();
    callback edited(string);

    VerticalLayout {
        spacing: 6px;

        if root.label != "": Text {
            text: root.label;
            color: Theme.text-secondary;
            font-family: Theme.font-family;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: root.text-align;
        }

        rect := Rectangle {
            min-height: root.custom-height;
            background: #14161f;
            border-radius: root.border-radius;
            border-width: 1px;
            border-color: input.has-focus ? #3b82f6 : #232634;

            animate border-color { duration: 150ms; }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: stretch;

                input := TextInput {
                    text <=> root.text;
                    input-type: root.input-type;
                    enabled: root.enabled;
                    color: Theme.text-primary;
                    font-family: Theme.font-family;
                    font-size: root.font-size;
                    vertical-alignment: center;
                    horizontal-alignment: root.text-align;
                    accepted => { root.accepted(); }
                    edited => { root.edited(self.text); }
                }
            }

            if root.text == "" && !input.has-focus: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: stretch;
                Text {
                    text: root.placeholder;
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: root.font-size;
                    vertical-alignment: center;
                    horizontal-alignment: root.text-align;
                }
            }
        }
    }
}
