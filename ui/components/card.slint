import { Theme } from "../theme.slint";

export component ServiceCard {
    in property <string> id: "";
    in property <string> name: "خدمة";
    in property <string> initial: "خ";
    in property <color> brand-color: #006837;
    in property <int> accounts-count: 1;
    in property <string> category: "عام";
    in property <bool> has-cover: false;
    in property <image> cover-image;
    in property <float> zoom-level: 1.0;
    in property <bool> show-title: true;

    callback clicked();
    callback right-clicked();

    width: 320px * root.zoom-level;
    height: 180px * root.zoom-level;

    rect := Rectangle {
        border-radius: 16px;
        background: #09090b;
        border-width: 1.5px;
        border-color: touch.has-hover ? #3b82f6 : #222533;
        clip: true;

        animate border-color { duration: 150ms; }

        // Poster Inner Frame
        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 12px;
            border-radius: 12px;
            clip: true;
            background: root.brand-color;

            // Ambient background gradient
            Rectangle {
                background: @linear-gradient(135deg, #000000.transparentize(0.2) 0%, #000000.transparentize(0.6) 100%);
            }

            // Cover Image if provided
            if root.has-cover: Image {
                source: root.cover-image;
                width: 100%;
                height: 100%;
                image-fit: contain;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Fallback: Large bold service title / initial
            if !root.has-cover: VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: root.initial;
                    color: #ffffff;
                    font-family: Theme.font-family;
                    font-size: 52px * root.zoom-level;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.name;
                    color: #ffffff;
                    font-family: Theme.font-family;
                    font-size: 18px * root.zoom-level;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }

            // Title scrim at bottom
            if root.show-title || touch.has-hover: Rectangle {
                y: parent.height - (44px * root.zoom-level);
                height: 44px * root.zoom-level;
                background: @linear-gradient(0deg, #000000.transparentize(0.15) 0%, transparent 100%);

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: space-between;

                    Text {
                        text: root.accounts-count <= 1 ? (root.accounts-count == 1 ? "1 حساب" : "فارغ") : (root.accounts-count + " حسابات");
                        color: #cbd5e1;
                        font-family: Theme.font-family;
                        font-size: 11px * root.zoom-level;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.name;
                        color: #ffffff;
                        font-family: Theme.font-family;
                        font-size: 15px * root.zoom-level;
                        font-weight: 800;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        touch := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.right-clicked();
                }
            }
            clicked => {
                root.clicked();
            }
            mouse-cursor: pointer;
        }
    }
}
