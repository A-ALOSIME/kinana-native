import "./fonts/thmanyahsans-Regular.otf";
import "./fonts/thmanyahsans-Bold.otf";
import { Theme } from "./theme.slint";
import { KinanaButton } from "./components/button.slint";
import { KinanaInput } from "./components/input.slint";
import { KinanaModal } from "./components/modal.slint";
import { ServiceCard } from "./components/card.slint";
import { ScrollView } from "std-widgets.slint";

export struct ServiceItem {
    id: string,
    name: string,
    initial: string,
    category: string,
    accounts_count: int,
    badge_color: color,
    has_cover: bool,
    cover_image: image,
}

export struct AccountItem {
    id: string,
    label: string,
    username: string,
    email: string,
    recovery_key: string,
    notes: string,
    url: string,
    has_password: bool,
}

export component MainWindow inherits Window {
    title: "كنانة";
    icon: @image-url("assets/icon.png");
    min-width: 950px;
    min-height: 650px;
    preferred-width: 1200px;
    preferred-height: 800px;
    default-font-family: Theme.font-family;
    background: Theme.bg-dark;

    // State properties
    in-out property <string> current_view: "unlock"; // "setup", "unlock", "dashboard"
    in-out property <string> status_message: "";
    in-out property <bool> is_error_status: false;

    in-out property <[ServiceItem]> services: [];
    in-out property <[AccountItem]> current_accounts: [];
    in-out property <int> total_accounts_count: 0;

    // Active Service in Details Modal
    in-out property <string> active_service_id: "";
    in-out property <string> active_service_name: "";
    in-out property <string> active_service_category: "";

    // Modals visibility
    in-out property <bool> show_add_service_modal: false;
    in-out property <bool> show_details_modal: false;
    in-out property <bool> show_add_account_modal: false;
    in-out property <bool> show_settings_modal: false;
    in-out property <bool> show_recovery_modal: false;

    // Toast
    in-out property <string> toast_text: "";
    in-out property <bool> show_toast: false;

    // Form fields for Setup
    in-out property <string> setup_pass: "";
    in-out property <string> setup_confirm: "";

    // Form fields for Unlock
    in-out property <string> unlock_pass: "";
    in-out property <bool> has_saved_credentials: true;

    // Form fields for Add Service
    in-out property <string> new_service_name: "";
    in-out property <string> new_service_category: "عام";
    in-out property <string> new_service_username: "";
    in-out property <string> new_service_password: "";
    in-out property <string> new_service_email: "";
    in-out property <string> new_service_recovery: "";
    in-out property <string> new_service_notes: "";
    in-out property <string> new_service_url: "";
    in-out property <string> new_service_icon_path: "";
    in-out property <bool> new_service_has_custom_icon: false;
    in-out property <image> new_service_preview_icon;

    // Form fields for Add Account
    in-out property <string> new_acc_label: "";
    in-out property <string> new_acc_username: "";
    in-out property <string> new_acc_password: "";
    in-out property <string> new_acc_email: "";
    in-out property <string> new_acc_recovery: "";
    in-out property <string> new_acc_notes: "";
    in-out property <string> new_acc_url: "";

    // Form fields for Password Generator
    in-out property <string> gen_password: "";

    // Form fields for Settings
    in-out property <int> auto_lock_timeout_mins: 5;
    in-out property <bool> auto_unlock_enabled: true;
    in-out property <string> emergency_key_display: "";
    in-out property <string> change_old_pass: "";
    in-out property <string> change_new_pass: "";
    in-out property <string> change_confirm_pass: "";

    // Form fields for Recovery
    in-out property <string> recovery_input_key: "";
    in-out property <string> recovery_new_pass: "";
    in-out property <string> recovery_confirm_pass: "";

    // Callbacks to Rust Backend
    callback try_create_vault(string, string);
    callback try_unlock(string);
    callback try_quick_unlock();
    callback recover_vault(string, string, string);
    callback lock_vault();
    callback export_backup();
    callback import_backup();
    callback add_service(string, string, string, string, string, string, string, string, string);
    callback delete_service(string);
    callback duplicate_service(string);
    callback open_service_details(string, string, string);
    callback add_account(string, string, string, string, string, string, string, string);
    callback delete_account(string, string);
    callback copy_service_password(string);
    callback copy_account_password(string, string);
    callback copy_to_clipboard(string);
    callback request_generate_password();
    callback change_master_password(string, string, string);
    callback set_auto_lock_timeout(int);
    callback toggle_auto_unlock(bool);
    callback open_external_url(string);
    callback pick_service_cover();
    callback remove_service_cover();

    // =========================================================================
    // ROOT LAYOUT
    // =========================================================================
    Rectangle {
        background: Theme.bg-dark;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // =====================================================================
            // TOP BAR (Visible only when unlocked on dashboard)
            // =====================================================================
            if root.current_view == "dashboard": Rectangle {
                height: 64px;
                background: #0d0f15;

                // Bottom border separator line
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #1c1e28;
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    // Left Side: Actions (Export, Import, Settings, Red Lock)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        // Red Lock Button (Matching Screenshot 4)
                        Rectangle {
                            height: 36px;
                            border-radius: 10px;
                            background: lock-touch.has-hover ? #b91c1c : #dc2626;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: "قفل";
                                    color: #ffffff;
                                    font-family: Theme.font-family;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            lock-touch := TouchArea {
                                clicked => {
                                    root.lock_vault();
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Settings Gear Button
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: set-touch.has-hover ? #222634 : #161822;
                            border-width: 1px;
                            border-color: #272a3a;

                            Text {
                                text: "⚙";
                                color: #ffffff;
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            set-touch := TouchArea {
                                clicked => {
                                    root.show_settings_modal = true;
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Export Backup Button
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: exp-touch.has-hover ? #222634 : #161822;
                            border-width: 1px;
                            border-color: #272a3a;

                            Text {
                                text: "⤓";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            exp-touch := TouchArea {
                                clicked => {
                                    root.export_backup();
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Import Backup Button
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: imp-touch.has-hover ? #222634 : #161822;
                            border-width: 1px;
                            border-color: #272a3a;

                            Text {
                                text: "⤒";
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            imp-touch := TouchArea {
                                clicked => {
                                    root.import_backup();
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    // Center: Floating Rounded Toolbar Capsule (Matching Screenshot 4)
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            border-radius: 16px;
                            background: #141620;
                            border-width: 1px;
                            border-color: #232635;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 8px;
                                alignment: center;

                                // + Add Service Button
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: add-btn-touch.has-hover ? #2563eb : #3b82f6;

                                    Text {
                                        text: "+";
                                        color: #ffffff;
                                        font-size: 18px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    add-btn-touch := TouchArea {
                                        clicked => {
                                            root.new_service_name = "";
                                            root.new_service_category = "عام";
                                            root.new_service_username = "";
                                            root.new_service_password = "";
                                            root.new_service_email = "";
                                            root.new_service_recovery = "";
                                            root.new_service_notes = "";
                                            root.new_service_url = "";
                                            root.new_service_icon_path = "";
                                            root.new_service_has_custom_icon = false;
                                            root.request_generate_password();
                                            root.show_add_service_modal = true;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Separator
                                Rectangle {
                                    width: 1px;
                                    height: 18px;
                                    background: #282c3c;
                                }

                                // 100% Zoom Indicator
                                Rectangle {
                                    border-radius: 6px;
                                    background: #1a1c27;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;

                                        Text {
                                            text: "100%";
                                            color: #cbd5e1;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Separator
                                Rectangle {
                                    width: 1px;
                                    height: 18px;
                                    background: #282c3c;
                                }

                                // Grid View Icon Button (Active)
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: #202434;

                                    Text {
                                        text: "⊞";
                                        color: #ffffff;
                                        font-size: 16px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Right Side: Brand & Status Pill (Matching Screenshot 4)
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        // Pill Badge
                        Rectangle {
                            border-radius: 20px;
                            background: #161822;
                            border-width: 1px;
                            border-color: #242736;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                alignment: center;

                                Text {
                                    text: "مفتوحة (" + root.services.length + " خدمات / " + root.total_accounts_count + " حساب)";
                                    color: #cbd5e1;
                                    font-family: Theme.font-family;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "كِنانة";
                            color: #ffffff;
                            font-family: Theme.font-family;
                            font-size: 22px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Image {
                            source: @image-url("assets/kinana-logo.svg");
                            width: 30px;
                            height: 30px;
                            image-fit: contain;
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 1: SETUP VIEW (First Run)
            // =========================================================================
            if root.current_view == "setup": Rectangle {
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 440px;
                            border-radius: 24px;
                            background: #111319;
                            border-width: 1px;
                            border-color: #202330;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 20px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 14px;

                                    Image {
                                        source: @image-url("assets/kinana-logo.png");
                                        width: 48px;
                                        height: 48px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: "كِنانة";
                                        color: #ffffff;
                                        font-size: 30px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "خزنة كلمات المرور الآمنة والمشفرة محلياً بالكامل";
                                    color: #9ca3af;
                                    font-size: 13px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "لم يتم العثور على خزنة سابقة. قم بإنشاء خزنتك الآن بتعيين كلمة مرور رئيسية أو رمز PIN قوي:";
                                    color: #cbd5e1;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }

                                if root.status_message != "": Text {
                                    text: root.status_message;
                                    color: root.is_error_status ? #fca5a5 : #6ee7b7;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                KinanaInput {
                                    label: "كلمة المرور الرئيسية أو رمز PIN:";
                                    placeholder: "اكتب رمز مرور قوي لا تنساه...";
                                    password: true;
                                    text-align: center;
                                    custom-height: 48px;
                                    border-radius: 12px;
                                    text <=> root.setup_pass;
                                }

                                KinanaInput {
                                    label: "تأكيد كلمة المرور:";
                                    placeholder: "أعد كتابة نفس الرمز للتأكيد...";
                                    password: true;
                                    text-align: center;
                                    custom-height: 48px;
                                    border-radius: 12px;
                                    text <=> root.setup_confirm;
                                }

                                KinanaButton {
                                    text: "إنشاء الخزنة وبدء الاستخدام";
                                    variant: "primary";
                                    custom-height: 48px;
                                    border-radius: 12px;
                                    custom-font-size: 15px;
                                    clicked => {
                                        root.try_create_vault(root.setup_pass, root.setup_confirm);
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    KinanaButton {
                                        text: "هل لديك نسخة سابقة من جهاز آخر؟ استيراد الخزنة (.dat)";
                                        variant: "ghost";
                                        custom-font-size: 12px;
                                        clicked => {
                                            root.import_backup();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 2: UNLOCK VIEW (Exact match to Screenshot 3)
            // =========================================================================
            if root.current_view == "unlock": Rectangle {
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 430px;
                            border-radius: 24px;
                            background: #111319;
                            border-width: 1px;
                            border-color: #202330;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 20px;

                                // Logo and Brand Title
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 14px;

                                    Image {
                                        source: @image-url("assets/kinana-logo.png");
                                        width: 52px;
                                        height: 52px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: "كِنانة";
                                        color: #ffffff;
                                        font-size: 32px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                // Subtitle
                                Text {
                                    text: "خزنة كلمات المرور الآمنة والمشفرة محلياً بالكامل";
                                    color: #9ca3af;
                                    font-size: 13px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                }

                                if root.status_message != "": Text {
                                    text: root.status_message;
                                    color: root.is_error_status ? #fca5a5 : #6ee7b7;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                // Input Label
                                Text {
                                    text: "أدخل رمز الدخول أو كلمة المرور الرئيسية:";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                // Password Input
                                KinanaInput {
                                    placeholder: "••••••••••••";
                                    password: true;
                                    text-align: center;
                                    custom-height: 50px;
                                    font-size: 18px;
                                    border-radius: 14px;
                                    text <=> root.unlock_pass;
                                    accepted => {
                                        root.try_unlock(root.unlock_pass);
                                    }
                                }

                                // Primary Button (Solid White with Black Text)
                                KinanaButton {
                                    text: "فتح الخزنة";
                                    variant: "primary";
                                    custom-height: 48px;
                                    border-radius: 14px;
                                    custom-font-size: 16px;
                                    clicked => {
                                        root.try_unlock(root.unlock_pass);
                                    }
                                }

                                // Secondary Button (Dark Auto-Unlock)
                                if root.has_saved_credentials: KinanaButton {
                                    text: "فتح تلقائياً بدون كلمة مرور";
                                    variant: "secondary";
                                    custom-height: 46px;
                                    border-radius: 14px;
                                    custom-font-size: 14px;
                                    clicked => {
                                        root.try_quick_unlock();
                                    }
                                }

                                // Footer Links
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 8px;
                                    alignment: center;

                                    KinanaButton {
                                        text: "نسيت كلمة المرور؟ استعادة الخزنة عبر مفتاح الطوارئ";
                                        variant: "ghost";
                                        custom-font-size: 12px;
                                        clicked => {
                                            root.show_recovery_modal = true;
                                        }
                                    }

                                    KinanaButton {
                                        text: "استيراد أو تبديل الخزنة من ملف (.dat)";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => {
                                            root.import_backup();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 3: DASHBOARD VIEW (Match Screenshot 4 Empty & Screenshot 5 Active)
            // =========================================================================
            if root.current_view == "dashboard": Rectangle {
                // Empty State (Exact match to Screenshot 4)
                if root.services.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 22px;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 110px;
                            height: 110px;
                            border-radius: 24px;
                            background: add-box-touch.has-hover ? #191c28 : #12141c;
                            border-width: 2px;
                            border-color: add-box-touch.has-hover ? #3b82f6 : #2a2e40;

                            Text {
                                text: "+";
                                color: add-box-touch.has-hover ? #3b82f6 : #8e95a5;
                                font-size: 48px;
                                font-weight: 300;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            add-box-touch := TouchArea {
                                clicked => {
                                    root.new_service_name = "";
                                    root.new_service_category = "عام";
                                    root.new_service_username = "";
                                    root.new_service_password = "";
                                    root.new_service_email = "";
                                    root.new_service_recovery = "";
                                    root.new_service_notes = "";
                                    root.new_service_url = "";
                                    root.new_service_icon_path = "";
                                    root.new_service_has_custom_icon = false;
                                    root.request_generate_password();
                                    root.show_add_service_modal = true;
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    Text {
                        text: "لا توجد خدمات مضافة حتى الآن";
                        color: #ffffff;
                        font-family: Theme.font-family;
                        font-size: 22px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }

                // Populated State (Netflix Grid matching Screenshot 5)
                if root.services.length > 0: ScrollView {
                    VerticalLayout {
                        padding: 32px;
                        spacing: 24px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: end;
                            spacing: 24px;

                            for service in root.services: ServiceCard {
                                id: service.id;
                                name: service.name;
                                initial: service.initial;
                                brand-color: service.badge_color;
                                accounts-count: service.accounts_count;
                                category: service.category;
                                has-cover: service.has_cover;
                                cover-image: service.cover_image;
                                clicked => {
                                    root.open_service_details(service.id, service.name, service.category);
                                }
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // TOAST NOTIFICATION
        // =========================================================================
        if root.show_toast: Rectangle {
            x: (parent.width - 320px) / 2;
            y: 76px;
            width: 320px;
            height: 44px;
            border-radius: 12px;
            background: #1e293b;
            border-width: 1px;
            border-color: #3b82f6;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: center;

                Text {
                    text: root.toast_text;
                    color: #ffffff;
                    font-family: Theme.font-family;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // =========================================================================
        // MODAL 1: ADD SERVICE MODAL (Scrollable, Image Picker, Pinned Buttons)
        // =========================================================================
        if root.show_add_service_modal: KinanaModal {
            title: "إضافة خدمة جديدة";
            modal-width: 520px;
            modal-max-height: 640px;
            close => { root.show_add_service_modal = false; }

            VerticalLayout {
                spacing: 14px;

                ScrollView {
                    height: 480px;

                    VerticalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 12px;

                        KinanaInput {
                            label: "اسم الخدمة أو الموقع";
                            placeholder: "مثال: أبشر، الراجحي، Gmail...";
                            text <=> root.new_service_name;
                        }

                        // Cover Image Picker
                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "غلاف أو صورة الخدمة:";
                                color: Theme.text-secondary;
                                font-family: Theme.font-family;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: right;
                            }

                            if root.new_service_has_custom_icon: HorizontalLayout {
                                spacing: 12px;
                                alignment: center;

                                Rectangle {
                                    width: 140px;
                                    height: 80px;
                                    border-radius: 10px;
                                    background: #161822;
                                    border-width: 1px;
                                    border-color: #3b82f6;

                                    Image {
                                        source: root.new_service_preview_icon;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    KinanaButton {
                                        text: "إزالة الغلاف";
                                        variant: "danger";
                                        custom-font-size: 12px;
                                        custom-height: 36px;
                                        clicked => {
                                            root.remove_service_cover();
                                        }
                                    }
                                }
                            }

                            if !root.new_service_has_custom_icon: KinanaButton {
                                text: "اختر صورة مخصصة من جهازك (PNG, JPG, SVG...)";
                                variant: "secondary";
                                custom-font-size: 13px;
                                custom-height: 42px;
                                clicked => {
                                    root.pick_service_cover();
                                }
                            }
                        }

                        KinanaInput {
                            label: "اسم المستخدم / المعرف";
                            placeholder: "اسم الحساب أو الإيميل...";
                            text <=> root.new_service_username;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            KinanaInput {
                                label: "كلمة المرور";
                                placeholder: "أدخل الرمز أو ولّده...";
                                text <=> root.new_service_password;
                            }
                            VerticalLayout {
                                alignment: end;
                                KinanaButton {
                                    text: "توليد";
                                    variant: "secondary";
                                    custom-height: 44px;
                                    clicked => {
                                        root.request_generate_password();
                                        root.new_service_password = root.gen_password;
                                    }
                                }
                            }
                        }

                        KinanaInput {
                            label: "البريد الإلكتروني (اختياري)";
                            placeholder: "user@example.com";
                            text <=> root.new_service_email;
                        }

                        KinanaInput {
                            label: "مفتاح استرداد الحساب (اختياري)";
                            placeholder: "Backup code / Recovery Key...";
                            text <=> root.new_service_recovery;
                        }

                        KinanaInput {
                            label: "ملاحظات إضافية (اختياري)";
                            placeholder: "أي معلومات أو تفاصيل مهمة...";
                            text <=> root.new_service_notes;
                        }

                        KinanaInput {
                            label: "رابط الموقع (اختياري)";
                            placeholder: "https://...";
                            text <=> root.new_service_url;
                        }
                    }
                }

                // Pinned Action Buttons (Always visible at bottom!)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    KinanaButton {
                        text: "إلغاء";
                        variant: "ghost";
                        clicked => { root.show_add_service_modal = false; }
                    }

                    KinanaButton {
                        text: "حفظ الخدمة";
                        variant: "primary";
                        clicked => {
                            root.add_service(
                                root.new_service_name,
                                root.new_service_category,
                                root.new_service_username,
                                root.new_service_password,
                                root.new_service_email,
                                root.new_service_recovery,
                                root.new_service_notes,
                                root.new_service_url,
                                root.new_service_icon_path
                            );
                            root.show_add_service_modal = false;
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 2: SERVICE DETAILS & ACCOUNTS
        // =========================================================================
        if root.show_details_modal: KinanaModal {
            title: root.active_service_name;
            modal-width: 620px;
            modal-max-height: 640px;
            close => { root.show_details_modal = false; }

            VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;

                        KinanaButton {
                            text: "تكرار";
                            variant: "secondary";
                            custom-font-size: 12px;
                            custom-height: 36px;
                            clicked => {
                                root.duplicate_service(root.active_service_id);
                                root.show_details_modal = false;
                            }
                        }

                        KinanaButton {
                            text: "حذف الخدمة";
                            variant: "danger";
                            custom-font-size: 12px;
                            custom-height: 36px;
                            clicked => {
                                root.delete_service(root.active_service_id);
                                root.show_details_modal = false;
                            }
                        }
                    }

                    KinanaButton {
                        text: "+ إضافة حساب";
                        variant: "primary";
                        custom-font-size: 12px;
                        custom-height: 36px;
                        clicked => {
                            root.new_acc_label = "";
                            root.new_acc_username = "";
                            root.new_acc_password = "";
                            root.new_acc_email = "";
                            root.new_acc_recovery = "";
                            root.new_acc_notes = "";
                            root.new_acc_url = "";
                            root.show_add_account_modal = true;
                        }
                    }
                }

                ScrollView {
                    height: 460px;

                    VerticalLayout {
                        spacing: 12px;
                        padding-bottom: 10px;

                        if root.current_accounts.length == 0: Text {
                            text: "لا توجد حسابات مسجلة تحت هذه الخدمة";
                            color: Theme.text-muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        for acc in root.current_accounts: Rectangle {
                            border-radius: 12px;
                            background: #141720;
                            border-width: 1px;
                            border-color: #242738;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    KinanaButton {
                                        text: "حذف الحساب";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => {
                                            root.delete_account(root.active_service_id, acc.id);
                                        }
                                    }

                                    Text {
                                        text: acc.label != "" ? acc.label : "حساب";
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                if acc.username != "": HorizontalLayout {
                                    alignment: space-between;
                                    KinanaButton {
                                        text: "نسخ";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => { root.copy_to_clipboard(acc.username); }
                                    }
                                    Text {
                                        text: "اسم المستخدم: " + acc.username;
                                        color: #cbd5e1;
                                        font-size: 13px;
                                    }
                                }

                                if acc.has_password: HorizontalLayout {
                                    alignment: space-between;
                                    KinanaButton {
                                        text: "نسخ الرمز";
                                        variant: "primary";
                                        custom-font-size: 11px;
                                        custom-height: 32px;
                                        clicked => {
                                            root.copy_account_password(root.active_service_id, acc.id);
                                        }
                                    }
                                    Text {
                                        text: "كلمة المرور: ••••••••••••";
                                        color: #cbd5e1;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }

                                if acc.email != "": HorizontalLayout {
                                    alignment: space-between;
                                    KinanaButton {
                                        text: "نسخ";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => { root.copy_to_clipboard(acc.email); }
                                    }
                                    Text {
                                        text: "البريد: " + acc.email;
                                        color: #94a3b8;
                                        font-size: 12px;
                                    }
                                }

                                if acc.recovery_key != "": HorizontalLayout {
                                    alignment: space-between;
                                    KinanaButton {
                                        text: "نسخ";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => { root.copy_to_clipboard(acc.recovery_key); }
                                    }
                                    Text {
                                        text: "مفتاح الاسترداد: " + acc.recovery_key;
                                        color: #f59e0b;
                                        font-size: 12px;
                                    }
                                }

                                if acc.notes != "": Text {
                                    text: "ملاحظات: " + acc.notes;
                                    color: #94a3b8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-alignment: right;
                                }

                                if acc.url != "": HorizontalLayout {
                                    alignment: end;
                                    KinanaButton {
                                        text: "فتح الرابط";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => { root.open_external_url(acc.url); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 3: ADD ACCOUNT TO SERVICE
        // =========================================================================
        if root.show_add_account_modal: KinanaModal {
            title: "إضافة حساب إلى: " + root.active_service_name;
            modal-width: 480px;
            modal-max-height: 600px;
            close => { root.show_add_account_modal = false; }

            VerticalLayout {
                spacing: 12px;

                ScrollView {
                    height: 420px;

                    VerticalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 12px;

                        KinanaInput {
                            label: "تسمية الحساب";
                            placeholder: "مثال: الحساب الشخصي، العمل...";
                            text <=> root.new_acc_label;
                        }

                        KinanaInput {
                            label: "اسم المستخدم / المعرف";
                            placeholder: "اسم الحساب أو الإيميل...";
                            text <=> root.new_acc_username;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            KinanaInput {
                                label: "كلمة المرور";
                                placeholder: "أدخل الرمز أو ولّده...";
                                text <=> root.new_acc_password;
                            }
                            VerticalLayout {
                                alignment: end;
                                KinanaButton {
                                    text: "توليد";
                                    variant: "secondary";
                                    custom-height: 44px;
                                    clicked => {
                                        root.request_generate_password();
                                        root.new_acc_password = root.gen_password;
                                    }
                                }
                            }
                        }

                        KinanaInput {
                            label: "البريد الإلكتروني (اختياري)";
                            placeholder: "user@example.com";
                            text <=> root.new_acc_email;
                        }

                        KinanaInput {
                            label: "مفتاح استرداد الحساب (اختياري)";
                            placeholder: "Backup code...";
                            text <=> root.new_acc_recovery;
                        }

                        KinanaInput {
                            label: "ملاحظات إضافية (اختياري)";
                            placeholder: "ملاحظات خاصة بهذا الحساب...";
                            text <=> root.new_acc_notes;
                        }

                        KinanaInput {
                            label: "رابط الموقع (اختياري)";
                            placeholder: "https://...";
                            text <=> root.new_acc_url;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    KinanaButton {
                        text: "إلغاء";
                        variant: "ghost";
                        clicked => { root.show_add_account_modal = false; }
                    }

                    KinanaButton {
                        text: "حفظ الحساب";
                        variant: "primary";
                        clicked => {
                            root.add_account(
                                root.active_service_id,
                                root.new_acc_label,
                                root.new_acc_username,
                                root.new_acc_password,
                                root.new_acc_email,
                                root.new_acc_recovery,
                                root.new_acc_notes,
                                root.new_acc_url
                            );
                            root.show_add_account_modal = false;
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 4: SETTINGS & BACKUP & SECURITY
        // =========================================================================
        if root.show_settings_modal: KinanaModal {
            title: "إعدادات الأمان واستعادة الخزنة";
            modal-width: 540px;
            modal-max-height: 640px;
            close => { root.show_settings_modal = false; }

            ScrollView {
                height: 520px;

                VerticalLayout {
                    spacing: 18px;
                    padding-left: 4px;
                    padding-right: 4px;

                    // Emergency Recovery Key Box
                    Rectangle {
                        border-radius: 12px;
                        background: #141722;
                        border-width: 1px;
                        border-color: #f59e0b.transparentize(0.5);

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "مفتاح الطوارئ لاستعادة الخزنة:";
                                color: #f59e0b;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: right;
                            }

                            Text {
                                text: root.emergency_key_display != "" ? root.emergency_key_display : "جاري التوليد...";
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                KinanaButton {
                                    text: "نسخ مفتاح الطوارئ";
                                    variant: "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => {
                                        root.copy_to_clipboard(root.emergency_key_display);
                                    }
                                }
                            }
                        }
                    }

                    // Master Password Change
                    VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "تغيير كلمة المرور الرئيسية:";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: right;
                        }

                        KinanaInput {
                            label: "كلمة المرور الحالية";
                            placeholder: "أدخل الرمز الحالي...";
                            password: true;
                            text <=> root.change_old_pass;
                        }

                        KinanaInput {
                            label: "كلمة المرور الجديدة";
                            placeholder: "أدخل الرمز الجديد...";
                            password: true;
                            text <=> root.change_new_pass;
                        }

                        KinanaInput {
                            label: "تأكيد كلمة المرور الجديدة";
                            placeholder: "أعد كتابة الرمز الجديد...";
                            password: true;
                            text <=> root.change_confirm_pass;
                        }

                        HorizontalLayout {
                            alignment: end;
                            KinanaButton {
                                text: "تحديث كلمة المرور";
                                variant: "primary";
                                clicked => {
                                    root.change_master_password(
                                        root.change_old_pass,
                                        root.change_new_pass,
                                        root.change_confirm_pass
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 5: EMERGENCY RECOVERY MODAL
        // =========================================================================
        if root.show_recovery_modal: KinanaModal {
            title: "استعادة الخزنة عبر مفتاح الطوارئ";
            modal-width: 480px;
            modal-max-height: 480px;
            close => { root.show_recovery_modal = false; }

            VerticalLayout {
                spacing: 16px;

                Text {
                    text: "إذا نسيت كلمة المرور الرئيسية، أدخل مفتاح الطوارئ المكون من 32 حرفاً لتعيين كلمة مرور جديدة:";
                    color: #94a3b8;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: right;
                }

                KinanaInput {
                    label: "مفتاح الطوارئ (32 رمز)";
                    placeholder: "ألصق مفتاح الطوارئ هنا...";
                    text <=> root.recovery_input_key;
                }

                KinanaInput {
                    label: "كلمة المرور الرئيسية الجديدة";
                    placeholder: "أدخل الرمز الجديد...";
                    password: true;
                    text <=> root.recovery_new_pass;
                }

                KinanaInput {
                    label: "تأكيد كلمة المرور الجديدة";
                    placeholder: "أعد إدخال الرمز الجديد...";
                    password: true;
                    text <=> root.recovery_confirm_pass;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    KinanaButton {
                        text: "إلغاء";
                        variant: "ghost";
                        clicked => { root.show_recovery_modal = false; }
                    }

                    KinanaButton {
                        text: "استعادة الخزنة وتعيين الرمز";
                        variant: "primary";
                        clicked => {
                            root.recover_vault(
                                root.recovery_input_key,
                                root.recovery_new_pass,
                                root.recovery_confirm_pass
                            );
                        }
                    }
                }
            }
        }
    }
}
