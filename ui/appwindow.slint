import "./fonts/thmanyahsans-Regular.otf";
import "./fonts/thmanyahsans-Bold.otf";
import { Theme } from "./theme.slint";
import { KinanaButton } from "./components/button.slint";
import { KinanaInput } from "./components/input.slint";
import { KinanaModal } from "./components/modal.slint";
import { ServiceCard } from "./components/card.slint";
import { ScrollView } from "std-widgets.slint";

export struct ServiceItem {
    id: string,
    name: string,
    initial: string,
    category: string,
    accounts_count: int,
    badge_color: color,
    has_cover: bool,
    cover_image: image,
}

export struct AccountItem {
    id: string,
    label: string,
    username: string,
    email: string,
    recovery_key: string,
    notes: string,
    url: string,
    has_password: bool,
    is_revealed: bool,
    actual_password: string,
}

export component MainWindow inherits Window {
    title: "كنانة";
    icon: @image-url("assets/icon.png");
    min-width: 950px;
    min-height: 650px;
    preferred-width: 1200px;
    preferred-height: 800px;
    default-font-family: Theme.font-family;
    background: Theme.bg-dark;

    // View state
    in-out property <string> current_view: "unlock"; // "setup", "unlock", "dashboard"
    in-out property <string> view_mode: "grid"; // "grid", "list"
    in-out property <float> zoom_level: 1.0;
    in-out property <string> status_message: "";
    in-out property <bool> is_error_status: false;

    // Data models
    in-out property <[ServiceItem]> services: [];
    in-out property <[AccountItem]> current_accounts: [];
    in-out property <int> total_accounts_count: 0;

    // Active Service in Details Modal
    in-out property <string> active_service_id: "";
    in-out property <string> active_service_name: "";
    in-out property <string> active_service_category: "";
    in-out property <image> active_service_cover;
    in-out property <bool> active_service_has_cover: false;

    // Modals visibility
    in-out property <bool> show_add_service_modal: false;
    in-out property <bool> show_details_modal: false;
    in-out property <bool> show_add_account_modal: false;
    in-out property <bool> show_settings_modal: false;
    in-out property <bool> show_recovery_modal: false;
    in-out property <bool> show_context_menu: false;

    // Context Menu State
    in-out property <string> ctx_service_id: "";
    in-out property <string> ctx_service_name: "";
    in-out property <string> ctx_service_category: "";

    // Toast
    in-out property <string> toast_text: "";
    in-out property <bool> show_toast: false;

    // Form fields for Setup
    in-out property <string> setup_pass: "";
    in-out property <string> setup_confirm: "";

    // Form fields for Unlock
    in-out property <string> unlock_pass: "";
    in-out property <bool> has_saved_credentials: true;

    // Form fields for Add Service
    in-out property <string> new_service_name: "";
    in-out property <string> new_service_category: "عام";
    in-out property <string> new_service_username: "";
    in-out property <string> new_service_password: "";
    in-out property <string> new_service_email: "";
    in-out property <string> new_service_recovery: "";
    in-out property <string> new_service_notes: "";
    in-out property <string> new_service_url: "";
    in-out property <string> new_service_icon_path: "";
    in-out property <bool> new_service_has_custom_icon: false;
    in-out property <image> new_service_preview_icon;

    // Form fields for Add Account
    in-out property <string> new_acc_tab: "login"; // "login", "card"
    in-out property <string> new_acc_label: "";
    in-out property <string> new_acc_username: "";
    in-out property <string> new_acc_password: "";
    in-out property <string> new_acc_email: "";
    in-out property <string> new_acc_recovery: "";
    in-out property <string> new_acc_notes: "";
    in-out property <string> new_acc_url: "";
    // Card fields
    in-out property <string> card_holder_name: "";
    in-out property <string> card_number: "";
    in-out property <string> card_expiry: "";
    in-out property <string> card_cvv: "";
    in-out property <string> card_pin: "";

    // Password Generator
    in-out property <string> gen_password: "";

    // Settings fields
    in-out property <int> auto_lock_timeout_mins: 5;
    in-out property <bool> auto_unlock_enabled: true;
    in-out property <string> emergency_key_display: "";
    in-out property <string> change_old_pass: "";
    in-out property <string> change_new_pass: "";
    in-out property <string> change_confirm_pass: "";

    // Recovery fields
    in-out property <string> recovery_input_key: "";
    in-out property <string> recovery_new_pass: "";
    in-out property <string> recovery_confirm_pass: "";

    // Callbacks to Rust Backend
    callback try_create_vault(string, string);
    callback try_unlock(string);
    callback try_quick_unlock();
    callback recover_vault(string, string, string);
    callback lock_vault();
    callback export_backup();
    callback import_backup();
    callback add_service(string, string, string, string, string, string, string, string, string);
    callback delete_service(string);
    callback duplicate_service(string);
    callback open_service_details(string, string, string);
    callback add_account(string, string, string, string, string, string, string, string);
    callback delete_account(string, string);
    callback copy_service_password(string);
    callback copy_account_password(string, string);
    callback copy_to_clipboard(string);
    callback request_generate_password();
    callback change_master_password(string, string, string);
    callback set_auto_lock_timeout(int);
    callback toggle_auto_unlock(bool);
    callback open_external_url(string);
    callback pick_service_cover();
    callback remove_service_cover();
    callback toggle_reveal_password(string, string);

    // Keyboard Shortcuts (Ctrl + +, Ctrl + -, Ctrl + 0, Esc)
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control {
                if event.text == "+" || event.text == "=" {
                    root.zoom_level = min(2.0, root.zoom_level + 0.1);
                    return accept;
                }
                if event.text == "-" {
                    root.zoom_level = max(0.5, root.zoom_level - 0.1);
                    return accept;
                }
                if event.text == "0" {
                    root.zoom_level = 1.0;
                    return accept;
                }
            }
            if event.text == Key.Escape {
                root.show_add_service_modal = false;
                root.show_details_modal = false;
                root.show_add_account_modal = false;
                root.show_settings_modal = false;
                root.show_recovery_modal = false;
                root.show_context_menu = false;
                return accept;
            }
            reject
        }
    }

    // Full-window TouchArea for Ctrl+Scroll zooming without blocking clicks
    TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        scroll-event(event) => {
            if event.modifiers.control {
                if event.delta-y > 0px {
                    root.zoom_level = min(2.0, root.zoom_level + 0.05);
                    return accept;
                } else if event.delta-y < 0px {
                    root.zoom_level = max(0.5, root.zoom_level - 0.05);
                    return accept;
                }
            }
            reject
        }
    }

    // =========================================================================
    // ROOT LAYOUT
    // =========================================================================
    Rectangle {
        background: Theme.bg-dark;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // =====================================================================
            // TOP BAR (Visible only when unlocked on dashboard)
            // =====================================================================
            if root.current_view == "dashboard": Rectangle {
                height: 64px;
                background: #0d0f15;

                // Bottom border separator line
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #1c1e28;
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    // Left Side: Actions (Red Lock, Settings, Export, Import)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        // Red Lock Button (Matching Screenshot 4)
                        Rectangle {
                            height: 38px;
                            border-radius: 10px;
                            background: lock-touch.has-hover ? #b91c1c : #dc2626;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                alignment: center;

                                Image {
                                    source: @image-url("assets/icons/lock.svg");
                                    width: 14px;
                                    height: 14px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "قفل";
                                    color: #ffffff;
                                    font-family: Theme.font-family;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            lock-touch := TouchArea {
                                clicked => {
                                    root.lock_vault();
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Settings Gear Button
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 10px;
                            background: set-touch.has-hover ? #222636 : #13151f;
                            border-width: 1px;
                            border-color: #26293a;

                            Image {
                                source: @image-url("assets/icons/settings.svg");
                                width: 17px;
                                height: 17px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            set-touch := TouchArea {
                                clicked => {
                                    root.show_settings_modal = true;
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Export Backup Button
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 10px;
                            background: exp-touch.has-hover ? #222636 : #13151f;
                            border-width: 1px;
                            border-color: #26293a;

                            Image {
                                source: @image-url("assets/icons/download.svg");
                                width: 17px;
                                height: 17px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            exp-touch := TouchArea {
                                clicked => {
                                    root.export_backup();
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Import Backup Button
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 10px;
                            background: imp-touch.has-hover ? #222636 : #13151f;
                            border-width: 1px;
                            border-color: #26293a;

                            Image {
                                source: @image-url("assets/icons/upload.svg");
                                width: 17px;
                                height: 17px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            imp-touch := TouchArea {
                                clicked => {
                                    root.import_backup();
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    // Center: Floating Rounded Toolbar Capsule (Matching Screenshot 4)
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            border-radius: 16px;
                            background: #141620;
                            border-width: 1px;
                            border-color: #232635;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 8px;
                                alignment: center;

                                // + Add Service Button (Solid White, Black Plus)
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: add-btn-touch.has-hover ? #e4e4e7 : #ffffff;

                                    Image {
                                        source: @image-url("assets/icons/plus-black.svg");
                                        width: 16px;
                                        height: 16px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    add-btn-touch := TouchArea {
                                        clicked => {
                                            root.new_service_name = "";
                                            root.new_service_category = "عام";
                                            root.new_service_username = "";
                                            root.new_service_password = "";
                                            root.new_service_email = "";
                                            root.new_service_recovery = "";
                                            root.new_service_notes = "";
                                            root.new_service_url = "";
                                            root.new_service_icon_path = "";
                                            root.new_service_has_custom_icon = false;
                                            root.request_generate_password();
                                            root.show_add_service_modal = true;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Separator
                                Rectangle {
                                    width: 1px;
                                    height: 18px;
                                    background: #282c3c;
                                }

                                // Zoom Controls (- 100% +)
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 6px;
                                    background: zm-out-touch.has-hover ? #20222f : transparent;

                                    Image {
                                        source: @image-url("assets/icons/zoom-out.svg");
                                        width: 14px;
                                        height: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    zm-out-touch := TouchArea {
                                        clicked => {
                                            root.zoom_level = max(0.5, root.zoom_level - 0.1);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                Rectangle {
                                    border-radius: 6px;
                                    background: #1a1c27;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: center;

                                        Text {
                                            text: Math.round(root.zoom_level * 100) + "%";
                                            color: #cbd5e1;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.zoom_level = 1.0;
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 6px;
                                    background: zm-in-touch.has-hover ? #20222f : transparent;

                                    Image {
                                        source: @image-url("assets/icons/zoom-in.svg");
                                        width: 14px;
                                        height: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    zm-in-touch := TouchArea {
                                        clicked => {
                                            root.zoom_level = min(2.0, root.zoom_level + 0.1);
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // Separator
                                Rectangle {
                                    width: 1px;
                                    height: 18px;
                                    background: #282c3c;
                                }

                                // Grid View Toggle Button
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: root.view_mode == "grid" ? #ffffff : (grid-hover.has-hover ? #252838 : #1e202b);

                                    Image {
                                        source: root.view_mode == "grid" ? @image-url("assets/icons/grid-black.svg") : @image-url("assets/icons/grid.svg");
                                        width: 15px;
                                        height: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    grid-hover := TouchArea {
                                        clicked => {
                                            root.view_mode = "grid";
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }

                                // List View Toggle Button
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: root.view_mode == "list" ? #ffffff : (list-hover.has-hover ? #252838 : #1e202b);

                                    Image {
                                        source: root.view_mode == "list" ? @image-url("assets/icons/list-black.svg") : @image-url("assets/icons/list.svg");
                                        width: 15px;
                                        height: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    list-hover := TouchArea {
                                        clicked => {
                                            root.view_mode = "list";
                                        }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // Right Side: Brand & Status Pill (Matching Screenshot 4)
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        // Pill Badge
                        Rectangle {
                            border-radius: 20px;
                            background: #161822;
                            border-width: 1px;
                            border-color: #242736;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    text: "مفتوحة (" + root.services.length + " خدمات / " + root.total_accounts_count + " حساب)";
                                    color: #cbd5e1;
                                    font-family: Theme.font-family;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Image {
                            source: @image-url("assets/kinana-logo.png");
                            height: 38px;
                            image-fit: contain;
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 1: SETUP VIEW (First Run)
            // =========================================================================
            if root.current_view == "setup": Rectangle {
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 440px;
                            border-radius: 24px;
                            background: #0d0e12;
                            border-width: 1px;
                            border-color: #1f2128;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 20px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 14px;

                                    Image {
                                        source: @image-url("assets/kinana-logo.png");
                                        width: 48px;
                                        height: 48px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: "كِنانة";
                                        color: #ffffff;
                                        font-size: 30px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "خزنة كلمات المرور الآمنة والمشفرة محلياً بالكامل";
                                    color: #9ca3af;
                                    font-size: 13px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "لم يتم العثور على خزنة سابقة. قم بإنشاء خزنتك الآن بتعيين كلمة مرور رئيسية أو رمز PIN قوي:";
                                    color: #cbd5e1;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }

                                if root.status_message != "": Text {
                                    text: root.status_message;
                                    color: root.is_error_status ? #fca5a5 : #6ee7b7;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                KinanaInput {
                                    label: "كلمة المرور الرئيسية أو رمز PIN:";
                                    placeholder: "اكتب رمز مرور قوي لا تنساه...";
                                    password: true;
                                    text-align: center;
                                    custom-height: 48px;
                                    border-radius: 12px;
                                    text <=> root.setup_pass;
                                }

                                KinanaInput {
                                    label: "تأكيد كلمة المرور:";
                                    placeholder: "أعد كتابة نفس الرمز للتأكيد...";
                                    password: true;
                                    text-align: center;
                                    custom-height: 48px;
                                    border-radius: 12px;
                                    text <=> root.setup_confirm;
                                }

                                KinanaButton {
                                    text: "إنشاء الخزنة وبدء الاستخدام";
                                    variant: "primary";
                                    custom-height: 48px;
                                    border-radius: 12px;
                                    custom-font-size: 15px;
                                    clicked => {
                                        root.try_create_vault(root.setup_pass, root.setup_confirm);
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    KinanaButton {
                                        text: "هل لديك نسخة سابقة من جهاز آخر؟ استيراد الخزنة (.dat)";
                                        variant: "ghost";
                                        custom-font-size: 12px;
                                        clicked => {
                                            root.import_backup();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 2: UNLOCK VIEW (Exact match to Screenshot 3)
            // =========================================================================
            if root.current_view == "unlock": Rectangle {
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 430px;
                            border-radius: 24px;
                            background: #0d0e12;
                            border-width: 1px;
                            border-color: #1f2128;

                            VerticalLayout {
                                padding: 36px;
                                spacing: 20px;

                                // Logo and Brand Title
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 14px;

                                    Image {
                                        source: @image-url("assets/kinana-logo.png");
                                        width: 52px;
                                        height: 52px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: "كِنانة";
                                        color: #ffffff;
                                        font-size: 32px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                // Subtitle
                                Text {
                                    text: "خزنة كلمات المرور الآمنة والمشفرة محلياً بالكامل";
                                    color: #9ca3af;
                                    font-size: 13px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                }

                                if root.status_message != "": Text {
                                    text: root.status_message;
                                    color: root.is_error_status ? #fca5a5 : #6ee7b7;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                // Input Label
                                Text {
                                    text: "أدخل رمز الدخول أو كلمة المرور الرئيسية:";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                // Password Input
                                KinanaInput {
                                    placeholder: "••••••••••••";
                                    password: true;
                                    text-align: center;
                                    custom-height: 50px;
                                    font-size: 18px;
                                    border-radius: 14px;
                                    text <=> root.unlock_pass;
                                    accepted => {
                                        root.try_unlock(root.unlock_pass);
                                    }
                                }

                                // Primary Button (Solid White with Black Text)
                                KinanaButton {
                                    text: "فتح الخزنة";
                                    variant: "primary";
                                    has-icon: true;
                                    icon: @image-url("assets/icons/lock.svg");
                                    custom-height: 48px;
                                    border-radius: 14px;
                                    custom-font-size: 16px;
                                    clicked => {
                                        root.try_unlock(root.unlock_pass);
                                    }
                                }

                                // Secondary Button (Dark Auto-Unlock)
                                if root.has_saved_credentials: KinanaButton {
                                    text: "فتح تلقائياً بدون كلمة مرور";
                                    variant: "secondary";
                                    has-icon: true;
                                    icon: @image-url("assets/icons/shield.svg");
                                    custom-height: 46px;
                                    border-radius: 14px;
                                    custom-font-size: 14px;
                                    clicked => {
                                        root.try_quick_unlock();
                                    }
                                }

                                // Footer Links
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 8px;
                                    alignment: center;

                                    KinanaButton {
                                        text: "نسيت كلمة المرور؟ استعادة الخزنة عبر مفتاح الطوارئ";
                                        variant: "ghost";
                                        custom-font-size: 12px;
                                        clicked => {
                                            root.show_recovery_modal = true;
                                        }
                                    }

                                    KinanaButton {
                                        text: "استيراد أو تبديل الخزنة من ملف (.dat)";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => {
                                            root.import_backup();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =========================================================================
            // VIEW 3: DASHBOARD VIEW (Match Screenshot 4 Empty & Screenshot 5 Active)
            // =========================================================================
            if root.current_view == "dashboard": Rectangle {
                // Empty State (Exact match to Screenshot 4)
                if root.services.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 22px;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 110px;
                            height: 110px;
                            border-radius: 24px;
                            background: add-box-touch.has-hover ? #191c28 : #12141c;
                            border-width: 2px;
                            border-color: add-box-touch.has-hover ? #3b82f6 : #2a2e40;

                            Image {
                                source: @image-url("assets/icons/plus.svg");
                                width: 44px;
                                height: 44px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            add-box-touch := TouchArea {
                                clicked => {
                                    root.new_service_name = "";
                                    root.new_service_category = "عام";
                                    root.new_service_username = "";
                                    root.new_service_password = "";
                                    root.new_service_email = "";
                                    root.new_service_recovery = "";
                                    root.new_service_notes = "";
                                    root.new_service_url = "";
                                    root.new_service_icon_path = "";
                                    root.new_service_has_custom_icon = false;
                                    root.request_generate_password();
                                    root.show_add_service_modal = true;
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    Text {
                        text: "لا توجد خدمات مضافة حتى الآن";
                        color: #ffffff;
                        font-family: Theme.font-family;
                        font-size: 22px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }

                // Grid View State (Netflix Grid matching Screenshot 5)
                if root.services.length > 0 && root.view_mode == "grid": ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        padding-top: 28px;
                        spacing: 24px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: end;
                            spacing: 20px;

                            for service in root.services: ServiceCard {
                                id: service.id;
                                name: service.name;
                                initial: service.initial;
                                brand-color: service.badge_color;
                                accounts-count: service.accounts_count;
                                category: service.category;
                                has-cover: service.has_cover;
                                cover-image: service.cover_image;
                                zoom-level: root.zoom_level;
                                clicked => {
                                    root.active_service_cover = service.cover_image;
                                    root.active_service_has_cover = service.has_cover;
                                    root.open_service_details(service.id, service.name, service.category);
                                }
                                right-clicked => {
                                    root.ctx_service_id = service.id;
                                    root.ctx_service_name = service.name;
                                    root.ctx_service_category = service.category;
                                    root.show_context_menu = true;
                                }
                            }
                        }
                    }
                }

                // List View State
                if root.services.length > 0 && root.view_mode == "list": ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;

                        for service in root.services: Rectangle {
                            height: 64px;
                            border-radius: 12px;
                            background: list-touch.has-hover ? #171922 : #0f1015;
                            border-width: 1px;
                            border-color: list-touch.has-hover ? #3b82f6 : #1f2128;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                // Actions on left
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    KinanaButton {
                                        text: "نسخ الرمز";
                                        variant: "secondary";
                                        custom-font-size: 12px;
                                        custom-height: 34px;
                                        has-icon: true;
                                        icon: @image-url("assets/icons/copy.svg");
                                        clicked => {
                                            root.copy_service_password(service.id);
                                        }
                                    }

                                    KinanaButton {
                                        text: "التفاصيل";
                                        variant: "ghost";
                                        custom-font-size: 12px;
                                        custom-height: 34px;
                                        clicked => {
                                            root.active_service_cover = service.cover_image;
                                            root.active_service_has_cover = service.has_cover;
                                            root.open_service_details(service.id, service.name, service.category);
                                        }
                                    }
                                }

                                // Service info on right
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: service.name;
                                            color: #ffffff;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-alignment: right;
                                        }

                                        Text {
                                            text: service.accounts_count + " حساب مسجل";
                                            color: #94a3b8;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                        }
                                    }

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 10px;
                                        background: service.badge_color;
                                        clip: true;

                                        if service.has_cover: Image {
                                            source: service.cover_image;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                        }

                                        if !service.has_cover: Text {
                                            text: service.initial;
                                            color: #ffffff;
                                            font-size: 20px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            list-touch := TouchArea {
                                clicked => {
                                    root.active_service_cover = service.cover_image;
                                    root.active_service_has_cover = service.has_cover;
                                    root.open_service_details(service.id, service.name, service.category);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // TOAST NOTIFICATION (Bottom Centered, Floating Pill)
        // =========================================================================
        if root.show_toast: Rectangle {
            x: (parent.width - 340px) / 2;
            y: parent.height - 68px;
            width: 340px;
            height: 44px;
            border-radius: 22px;
            background: #141724;
            border-width: 1px;
            border-color: #3b82f6.transparentize(0.4);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                spacing: 8px;

                Image {
                    source: @image-url("assets/icons/check.svg");
                    width: 15px;
                    height: 15px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.toast_text;
                    color: #ffffff;
                    font-family: Theme.font-family;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        // =========================================================================
        // RIGHT-CLICK CONTEXT MENU
        // =========================================================================
        if root.show_context_menu: KinanaModal {
            title: root.ctx_service_name;
            modal-width: 340px;
            modal-max-height: 280px;
            close => { root.show_context_menu = false; }

            VerticalLayout {
                spacing: 8px;

                KinanaButton {
                    text: "تعديل البيانات والحسابات";
                    variant: "secondary";
                    has-icon: true;
                    icon: @image-url("assets/icons/key.svg");
                    custom-font-size: 13px;
                    clicked => {
                        root.show_context_menu = false;
                        root.open_service_details(root.ctx_service_id, root.ctx_service_name, root.ctx_service_category);
                    }
                }

                KinanaButton {
                    text: "تكرار الخدمة";
                    variant: "secondary";
                    has-icon: true;
                    icon: @image-url("assets/icons/copy.svg");
                    custom-font-size: 13px;
                    clicked => {
                        root.show_context_menu = false;
                        root.duplicate_service(root.ctx_service_id);
                    }
                }

                KinanaButton {
                    text: "حذف الخدمة";
                    variant: "danger";
                    has-icon: true;
                    icon: @image-url("assets/icons/trash.svg");
                    custom-font-size: 13px;
                    clicked => {
                        root.show_context_menu = false;
                        root.delete_service(root.ctx_service_id);
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 1: ADD SERVICE MODAL (Scrollable, Image Picker, Pinned Buttons)
        // =========================================================================
        if root.show_add_service_modal: KinanaModal {
            title: "إضافة خدمة جديدة";
            modal-width: 520px;
            modal-max-height: 640px;
            close => { root.show_add_service_modal = false; }

            VerticalLayout {
                spacing: 14px;

                ScrollView {
                    height: 480px;

                    VerticalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 12px;

                        KinanaInput {
                            label: "اسم الخدمة أو الموقع";
                            placeholder: "مثال: أبشر، الراجحي، Gmail...";
                            text <=> root.new_service_name;
                        }

                        // Cover Image Picker
                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "غلاف أو صورة الخدمة:";
                                color: Theme.text-secondary;
                                font-family: Theme.font-family;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: right;
                            }

                            if root.new_service_has_custom_icon: HorizontalLayout {
                                spacing: 12px;
                                alignment: center;

                                Rectangle {
                                    width: 140px;
                                    height: 80px;
                                    border-radius: 10px;
                                    background: #161822;
                                    border-width: 1px;
                                    border-color: #3b82f6;

                                    Image {
                                        source: root.new_service_preview_icon;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    KinanaButton {
                                        text: "إزالة الغلاف";
                                        variant: "danger";
                                        has-icon: true;
                                        icon: @image-url("assets/icons/trash.svg");
                                        custom-font-size: 12px;
                                        custom-height: 36px;
                                        clicked => {
                                            root.remove_service_cover();
                                        }
                                    }
                                }
                            }

                            if !root.new_service_has_custom_icon: KinanaButton {
                                text: "اختر صورة مخصصة من جهازك (PNG, JPG, SVG...)";
                                variant: "secondary";
                                has-icon: true;
                                icon: @image-url("assets/icons/upload.svg");
                                custom-font-size: 13px;
                                custom-height: 42px;
                                clicked => {
                                    root.pick_service_cover();
                                }
                            }
                        }

                        KinanaInput {
                            label: "اسم المستخدم / المعرف";
                            placeholder: "اسم الحساب أو الإيميل...";
                            text <=> root.new_service_username;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            KinanaInput {
                                label: "كلمة المرور";
                                placeholder: "أدخل الرمز أو ولّده...";
                                text <=> root.new_service_password;
                            }
                            VerticalLayout {
                                alignment: end;
                                KinanaButton {
                                    text: "توليد";
                                    variant: "secondary";
                                    has-icon: true;
                                    icon: @image-url("assets/icons/dices.svg");
                                    custom-height: 44px;
                                    clicked => {
                                        root.request_generate_password();
                                        root.new_service_password = root.gen_password;
                                    }
                                }
                            }
                        }

                        KinanaInput {
                            label: "البريد الإلكتروني (اختياري)";
                            placeholder: "user@example.com";
                            text <=> root.new_service_email;
                        }

                        KinanaInput {
                            label: "مفتاح استرداد الحساب (اختياري)";
                            placeholder: "Backup code / Recovery Key...";
                            text <=> root.new_service_recovery;
                        }

                        KinanaInput {
                            label: "ملاحظات إضافية (اختياري)";
                            placeholder: "أي معلومات أو تفاصيل مهمة...";
                            text <=> root.new_service_notes;
                        }

                        KinanaInput {
                            label: "رابط الموقع (اختياري)";
                            placeholder: "https://...";
                            text <=> root.new_service_url;
                        }
                    }
                }

                // Pinned Action Buttons
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    KinanaButton {
                        text: "إلغاء";
                        variant: "ghost";
                        clicked => { root.show_add_service_modal = false; }
                    }

                    KinanaButton {
                        text: "حفظ الخدمة";
                        variant: "primary";
                        clicked => {
                            root.add_service(
                                root.new_service_name,
                                root.new_service_category,
                                root.new_service_username,
                                root.new_service_password,
                                root.new_service_email,
                                root.new_service_recovery,
                                root.new_service_notes,
                                root.new_service_url,
                                root.new_service_icon_path
                            );
                            root.show_add_service_modal = false;
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 2: SERVICE DETAILS & ACCOUNTS (Exact match to Screenshot 2)
        // =========================================================================
        if root.show_details_modal: KinanaModal {
            title: "";
            show-default-header: false;
            modal-width: 780px;
            modal-max-height: 720px;
            close => { root.show_details_modal = false; }

            VerticalLayout {
                spacing: 18px;

                // Header matching Screenshot 2
                HorizontalLayout {
                    alignment: space-between;

                    // Left Side: Delete Service, + Add Account, Edit Service
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        // Red Trash Button (Delete Service)
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 12px;
                            background: del-svc-touch.has-hover ? #991b1b : #dc2626;

                            Image {
                                source: @image-url("assets/icons/trash.svg");
                                width: 17px;
                                height: 17px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            del-svc-touch := TouchArea {
                                clicked => {
                                    root.delete_service(root.active_service_id);
                                    root.show_details_modal = false;
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // Add Account (Solid White Pill Button)
                        KinanaButton {
                            text: "إضافة حساب";
                            variant: "primary";
                            has-icon: true;
                            icon: @image-url("assets/icons/plus-black.svg");
                            custom-font-size: 13px;
                            custom-height: 42px;
                            border-radius: 12px;
                            clicked => {
                                root.new_acc_label = "";
                                root.new_acc_username = "";
                                root.new_acc_password = "";
                                root.new_acc_email = "";
                                root.new_acc_recovery = "";
                                root.new_acc_notes = "";
                                root.new_acc_url = "";
                                root.show_add_account_modal = true;
                            }
                        }

                        // Edit Service Button
                        KinanaButton {
                            text: "تعديل الخدمة والصورة";
                            variant: "outline";
                            has-icon: true;
                            icon: @image-url("assets/icons/pencil.svg");
                            custom-font-size: 13px;
                            custom-height: 42px;
                            border-radius: 12px;
                            clicked => {
                                root.show_details_modal = false;
                                root.new_service_name = root.active_service_name;
                                root.show_add_service_modal = true;
                            }
                        }
                    }

                    // Right Side: Thumbnail Cover + Service Name + Count + Close X
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: root.active_service_name;
                                color: #ffffff;
                                font-size: 24px;
                                font-weight: 800;
                                horizontal-alignment: right;
                            }

                            Text {
                                text: root.current_accounts.length + " حساب مسجل";
                                color: #8e95a5;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: right;
                            }
                        }

                        // Thumbnail
                        Rectangle {
                            width: 64px;
                            height: 44px;
                            border-radius: 10px;
                            background: #006837;
                            clip: true;

                            if root.active_service_has_cover: Image {
                                source: root.active_service_cover;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }

                        // Close X Button
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: close-det-x.has-hover ? #202330 : transparent;

                            Image {
                                source: @image-url("assets/icons/x.svg");
                                width: 14px;
                                height: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            close-det-x := TouchArea {
                                clicked => {
                                    root.show_details_modal = false;
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // Accounts List (Matching Screenshot 2 Cards)
                ScrollView {
                    height: 500px;

                    VerticalLayout {
                        spacing: 16px;
                        padding-bottom: 12px;

                        if root.current_accounts.length == 0: Text {
                            text: "لا توجد حسابات مسجلة تحت هذه الخدمة";
                            color: Theme.text-muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        for acc in root.current_accounts: Rectangle {
                            border-radius: 16px;
                            background: #11131c;
                            border-width: 1px;
                            border-color: #202434;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                // Account Header Row: Label on right, actions on left
                                HorizontalLayout {
                                    alignment: space-between;

                                    // Action buttons on left: Red Trash, Edit, Duplicate
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        // Red Trash Icon
                                        Rectangle {
                                            width: 34px;
                                            height: 34px;
                                            border-radius: 8px;
                                            background: del-acc-touch.has-hover ? #7f1d1d.transparentize(0.5) : transparent;

                                            Image {
                                                source: @image-url("assets/icons/trash.svg");
                                                width: 15px;
                                                height: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            del-acc-touch := TouchArea {
                                                clicked => {
                                                    root.delete_account(root.active_service_id, acc.id);
                                                }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        // Edit Button
                                        KinanaButton {
                                            text: "تعديل";
                                            variant: "outline";
                                            has-icon: true;
                                            icon: @image-url("assets/icons/pencil.svg");
                                            custom-font-size: 12px;
                                            custom-height: 34px;
                                            border-radius: 8px;
                                            clicked => {
                                                root.new_acc_label = acc.label;
                                                root.new_acc_username = acc.username;
                                                root.new_acc_email = acc.email;
                                                root.new_acc_recovery = acc.recovery_key;
                                                root.new_acc_notes = acc.notes;
                                                root.new_acc_url = acc.url;
                                                root.show_add_account_modal = true;
                                            }
                                        }

                                        // Duplicate Button
                                        KinanaButton {
                                            text: "تكرار";
                                            variant: "outline";
                                            has-icon: true;
                                            icon: @image-url("assets/icons/copy.svg");
                                            custom-font-size: 12px;
                                            custom-height: 34px;
                                            border-radius: 8px;
                                            clicked => {
                                                root.add_account(
                                                    root.active_service_id,
                                                    acc.label + " (نسخة)",
                                                    acc.username,
                                                    "",
                                                    acc.email,
                                                    acc.recovery_key,
                                                    acc.notes,
                                                    acc.url
                                                );
                                            }
                                        }
                                    }

                                    // Right: Account Label + Key Icon
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: center;

                                        Text {
                                            text: acc.label != "" ? acc.label : "حساب تسجيل دخول";
                                            color: #ffffff;
                                            font-size: 18px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: 30px;
                                            height: 30px;
                                            border-radius: 8px;
                                            background: #1c202e;

                                            Image {
                                                source: @image-url("assets/icons/key.svg");
                                                width: 15px;
                                                height: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Field 1: Username Row (Two-line Vertical Layout)
                                if acc.username != "": Rectangle {
                                    height: 52px;
                                    border-radius: 12px;
                                    background: #161824;
                                    border-width: 1px;
                                    border-color: #24283b;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 16px;
                                        alignment: space-between;

                                        KinanaButton {
                                            text: "نسخ";
                                            variant: "secondary";
                                            has-icon: true;
                                            icon: @image-url("assets/icons/copy.svg");
                                            custom-font-size: 12px;
                                            custom-height: 34px;
                                            border-radius: 8px;
                                            clicked => { root.copy_to_clipboard(acc.username); }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "اسم المستخدم";
                                                color: #8e95a5;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }

                                            Text {
                                                text: acc.username;
                                                color: #ffffff;
                                                font-size: 14px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                // Field 2: Password Row (Two-line Vertical Layout)
                                if acc.has_password: Rectangle {
                                    height: 52px;
                                    border-radius: 12px;
                                    background: #161824;
                                    border-width: 1px;
                                    border-color: #24283b;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 16px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;

                                            // Solid White Copy Password Button
                                            KinanaButton {
                                                text: "نسخ كلمة المرور";
                                                variant: "primary";
                                                has-icon: true;
                                                icon: @image-url("assets/icons/copy-black.svg");
                                                custom-font-size: 12px;
                                                custom-height: 34px;
                                                border-radius: 8px;
                                                clicked => {
                                                    root.copy_account_password(root.active_service_id, acc.id);
                                                }
                                            }

                                            // Eye Reveal Button
                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                border-radius: 8px;
                                                background: eye-touch.has-hover ? #252838 : transparent;

                                                Image {
                                                    source: acc.is_revealed ? @image-url("assets/icons/eye-off.svg") : @image-url("assets/icons/eye.svg");
                                                    width: 16px;
                                                    height: 16px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                eye-touch := TouchArea {
                                                    clicked => {
                                                        root.toggle_reveal_password(root.active_service_id, acc.id);
                                                    }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "كلمة المرور";
                                                color: #8e95a5;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }

                                            Text {
                                                text: acc.is_revealed ? acc.actual_password : "••••••••••••••••";
                                                color: acc.is_revealed ? #34d399 : #ffffff;
                                                font-size: 15px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                // Field 3: Recovery Key Row (Amber theme)
                                if acc.recovery_key != "": Rectangle {
                                    height: 52px;
                                    border-radius: 12px;
                                    background: #1b160f;
                                    border-width: 1px;
                                    border-color: #d97706.transparentize(0.4);

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 16px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;

                                            KinanaButton {
                                                text: "نسخ المفتاح";
                                                variant: "amber";
                                                has-icon: true;
                                                icon: @image-url("assets/icons/copy-amber.svg");
                                                custom-font-size: 12px;
                                                custom-height: 34px;
                                                border-radius: 8px;
                                                clicked => { root.copy_to_clipboard(acc.recovery_key); }
                                            }

                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                border-radius: 8px;
                                                background: eye-rec-touch.has-hover ? #2d2012 : transparent;

                                                Image {
                                                    source: @image-url("assets/icons/eye-amber.svg");
                                                    width: 16px;
                                                    height: 16px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                eye-rec-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "مفتاح استرداد الحساب للطوارئ (Recovery Key)";
                                                color: #d97706;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }

                                            Text {
                                                text: acc.recovery_key;
                                                color: #fbbf24;
                                                font-size: 14px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                if acc.notes != "": Text {
                                    text: "ملاحظات: " + acc.notes;
                                    color: #94a3b8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-alignment: right;
                                }

                                if acc.url != "": HorizontalLayout {
                                    alignment: end;
                                    KinanaButton {
                                        text: "فتح الرابط";
                                        variant: "ghost";
                                        custom-font-size: 11px;
                                        clicked => { root.open_external_url(acc.url); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 3: ADD / EDIT ACCOUNT (Tabs: Login Account vs Bank Card, Screenshot 4 & 5)
        // =========================================================================
        if root.show_add_account_modal: KinanaModal {
            title: "تعديل الحساب";
            modal-width: 540px;
            modal-max-height: 680px;
            close => { root.show_add_account_modal = false; }

            VerticalLayout {
                spacing: 14px;

                Text {
                    text: "تعديل بيانات حساب تسجيل الدخول أو البطاقة البنكية.";
                    color: #94a3b8;
                    font-size: 13px;
                    horizontal-alignment: right;
                }

                // Tab Switcher (Matching Screenshot 4)
                Rectangle {
                    height: 44px;
                    border-radius: 12px;
                    background: #141620;
                    border-width: 1px;
                    border-color: #242738;

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;

                        // Tab 2: Bank Card
                        Rectangle {
                            border-radius: 8px;
                            background: root.new_acc_tab == "card" ? #ffffff : transparent;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;

                                Image {
                                    source: @image-url("assets/icons/credit-card.svg");
                                    width: 15px;
                                    height: 15px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "بطاقة بنكية / دفع";
                                    color: root.new_acc_tab == "card" ? #000000 : #cbd5e1;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.new_acc_tab = "card"; }
                                mouse-cursor: pointer;
                            }
                        }

                        // Tab 1: Login Account
                        Rectangle {
                            border-radius: 8px;
                            background: root.new_acc_tab == "login" ? #ffffff : transparent;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;

                                Image {
                                    source: @image-url("assets/icons/user.svg");
                                    width: 15px;
                                    height: 15px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "حساب تسجيل دخول";
                                    color: root.new_acc_tab == "login" ? #000000 : #cbd5e1;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.new_acc_tab = "login"; }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }

                // Tab Content wrapped in ScrollView
                ScrollView {
                    height: 420px;

                    VerticalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 12px;

                        // TAB 1: LOGIN ACCOUNT (Screenshot 4)
                        if root.new_acc_tab == "login": VerticalLayout {
                            spacing: 12px;

                            KinanaInput {
                                label: "تسمية الحساب";
                                placeholder: "مثال: الحساب الشخصي، العمل...";
                                text <=> root.new_acc_label;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                KinanaInput {
                                    label: "البريد الإلكتروني";
                                    placeholder: "user@example.com";
                                    text <=> root.new_acc_email;
                                }
                                KinanaInput {
                                    label: "اسم المستخدم";
                                    placeholder: "اسم الحساب أو المعرف...";
                                    text <=> root.new_acc_username;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                KinanaInput {
                                    label: "كلمة المرور الجديدة (اختياري)";
                                    placeholder: "اتركه فارغاً للإبقاء على كلمة المرور الحالية...";
                                    text <=> root.new_acc_password;
                                }
                                VerticalLayout {
                                    alignment: end;
                                    KinanaButton {
                                        text: "توليد كلمة جديدة";
                                        variant: "secondary";
                                        has-icon: true;
                                        icon: @image-url("assets/icons/dices.svg");
                                        custom-height: 44px;
                                        clicked => {
                                            root.request_generate_password();
                                            root.new_acc_password = root.gen_password;
                                        }
                                    }
                                }
                            }

                            KinanaInput {
                                label: "مفتاح استرداد الحساب (Recovery Key)";
                                placeholder: "Backup code / Recovery Key...";
                                text <=> root.new_acc_recovery;
                            }

                            KinanaInput {
                                label: "الرابط";
                                placeholder: "https://...";
                                text <=> root.new_acc_url;
                            }

                            KinanaInput {
                                label: "الملاحظات";
                                placeholder: "أي ملاحظات إضافية...";
                                text <=> root.new_acc_notes;
                            }
                        }

                        // TAB 2: BANK CARD (Screenshot 5)
                        if root.new_acc_tab == "card": VerticalLayout {
                            spacing: 14px;

                            // Realistic Credit Card Graphic (Matching Screenshot 5)
                            Rectangle {
                                height: 160px;
                                border-radius: 16px;
                                background: @linear-gradient(135deg, #182038 0%, #0d1020 100%);
                                border-width: 1px;
                                border-color: #273352;
                                clip: true;

                                VerticalLayout {
                                    padding: 16px;
                                    alignment: space-between;

                                    // Top Row: BANK CARD badge on left, Gold Chip on right
                                    HorizontalLayout {
                                        alignment: space-between;

                                        Rectangle {
                                            border-radius: 6px;
                                            background: #252e4a;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                Text {
                                                    text: "BANK CARD";
                                                    color: #cbd5e1;
                                                    font-size: 10px;
                                                    font-weight: 800;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: center;

                                            Text {
                                                text: root.new_acc_label != "" ? root.new_acc_label : "بطاقة بنكية";
                                                color: #ffffff;
                                                font-size: 14px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            // Gold Chip
                                            Rectangle {
                                                width: 36px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: #d97706;
                                                border-width: 1px;
                                                border-color: #f59e0b;
                                            }
                                        }
                                    }

                                    // Middle: Card Number Dots
                                    Text {
                                        text: root.card_number != "" ? root.card_number : "••••  ••••  ••••  ••••";
                                        color: #ffffff;
                                        font-size: 18px;
                                        font-weight: 700;
                                        letter-spacing: 2px;
                                        horizontal-alignment: center;
                                    }

                                    // Bottom Row: Expiry on left, Cardholder Name on right
                                    HorizontalLayout {
                                        alignment: space-between;

                                        VerticalLayout {
                                            Text {
                                                text: "تنتهي في";
                                                color: #94a3b8;
                                                font-size: 9px;
                                            }
                                            Text {
                                                text: root.card_expiry != "" ? root.card_expiry : "MM/YY";
                                                color: #ffffff;
                                                font-size: 12px;
                                                font-weight: 700;
                                            }
                                        }

                                        VerticalLayout {
                                            Text {
                                                text: "حامل البطاقة";
                                                color: #94a3b8;
                                                font-size: 9px;
                                                horizontal-alignment: right;
                                            }
                                            Text {
                                                text: root.card_holder_name != "" ? root.card_holder_name : "CARDHOLDER NAME";
                                                color: #ffffff;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }

                            KinanaInput {
                                label: "تسمية البطاقة (اختياري)";
                                placeholder: "مثال: بطاقة الراجحي مدى...";
                                text <=> root.new_acc_label;
                            }

                            KinanaInput {
                                label: "اسم حامل البطاقة (Cardholder Name)";
                                placeholder: "الاسم كما هو مطبوع على البطاقة...";
                                text <=> root.card_holder_name;
                            }

                            KinanaInput {
                                label: "رقم البطاقة الجديد (16 رقماً - اختياري)";
                                placeholder: "اتركه فارغاً للإبقاء على رقم البطاقة الحالي...";
                                text <=> root.card_number;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                KinanaInput {
                                    label: "رمز الأمان (CVV / CVC)";
                                    placeholder: "123";
                                    text <=> root.card_cvv;
                                }
                                KinanaInput {
                                    label: "تاريخ الانتهاء (MM/YY)";
                                    placeholder: "08/29";
                                    text <=> root.card_expiry;
                                }
                            }

                            KinanaInput {
                                label: "الرمز السري للبطاقة (PIN - اختياري)";
                                placeholder: "رمز الصراف المكون من 4 أرقام...";
                                password: true;
                                text <=> root.card_pin;
                            }

                            KinanaInput {
                                label: "ملاحظات إضافية (اختياري)";
                                placeholder: "ملاحظات خاصة بالبطاقة...";
                                text <=> root.new_acc_notes;
                            }
                        }
                    }
                }

                // Pinned Footer Buttons
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    KinanaButton {
                        text: "إلغاء";
                        variant: "ghost";
                        clicked => { root.show_add_account_modal = false; }
                    }

                    KinanaButton {
                        text: "حفظ التعديلات";
                        variant: "primary";
                        clicked => {
                            let final_label = root.new_acc_label != "" ? root.new_acc_label : (root.new_acc_tab == "card" ? "بطاقة دفع" : "حساب");
                            let final_user = root.new_acc_tab == "card" ? root.card_holder_name : root.new_acc_username;
                            let final_pass = root.new_acc_tab == "card" ? root.card_number : root.new_acc_password;
                            let final_notes = root.new_acc_tab == "card" ? ("EXP:" + root.card_expiry + "|CVV:" + root.card_cvv + "|PIN:" + root.card_pin + "|" + root.new_acc_notes) : root.new_acc_notes;

                            root.add_account(
                                root.active_service_id,
                                final_label,
                                final_user,
                                final_pass,
                                root.new_acc_email,
                                root.new_acc_recovery,
                                final_notes,
                                root.new_acc_url
                            );
                            root.show_add_account_modal = false;
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 4: SETTINGS & BACKUP & SECURITY (Matching Screenshot 3)
        // =========================================================================
        if root.show_settings_modal: KinanaModal {
            title: "إعدادات الأمان واستعادة الخزنة";
            modal-width: 580px;
            modal-max-height: 680px;
            close => { root.show_settings_modal = false; }

            ScrollView {
                height: 540px;

                VerticalLayout {
                    spacing: 18px;
                    padding-left: 4px;
                    padding-right: 4px;

                    // SECTION 1: AUTO-UNLOCK (Passwordless)
                    Rectangle {
                        border-radius: 16px;
                        background: #111218;
                        border-width: 1px;
                        border-color: #20222e;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;

                                KinanaButton {
                                    text: "تعطيل الفتح التلقائي";
                                    variant: "danger";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => {
                                        root.toggle_auto_unlock(false);
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    VerticalLayout {
                                        Text {
                                            text: "الفتح التلقائي (Passwordless by default)";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                            horizontal-alignment: right;
                                        }
                                        Text {
                                            text: "مفعل: يتم فتح كنانة تلقائياً عبر مخزن ويندوز الآمن.";
                                            color: #94a3b8;
                                            font-size: 12px;
                                            horizontal-alignment: right;
                                        }
                                    }

                                    Image {
                                        source: @image-url("assets/icons/shield.svg");
                                        width: 18px;
                                        height: 18px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Amber Notice Box
                            Rectangle {
                                border-radius: 10px;
                                background: #1c1810;
                                border-width: 1px;
                                border-color: #d97706.transparentize(0.5);

                                HorizontalLayout {
                                    padding: 10px;
                                    Text {
                                        text: "تنبيه: يتم حفظ رمز الدخول محلياً في Windows Credential Manager. هذا يعني إمكانية الوصول إليه من أي برنامج يعمل بنفس صلاحياتك.";
                                        color: #f59e0b;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }

                    // SECTION 2: AUTO-LOCK TIMEOUT (Screenshot 3)
                    Rectangle {
                        border-radius: 16px;
                        background: #111218;
                        border-width: 1px;
                        border-color: #20222e;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                VerticalLayout {
                                    Text {
                                        text: "القفل التلقائي عند الخمول (Auto-Lock Timeout)";
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 700;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: "يقفل التطبيق تلقائياً لحماية بياناتك إذا لم يتم تسجيل أي نشاط لفترة محددة.";
                                        color: #94a3b8;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                    }
                                }

                                Image {
                                    source: @image-url("assets/icons/clock.svg");
                                    width: 18px;
                                    height: 18px;
                                    vertical-alignment: center;
                                }
                            }

                            // Preset Pills Row 1
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                KinanaButton {
                                    text: "15 دقيقة";
                                    variant: root.auto_lock_timeout_mins == 15 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(15); }
                                }
                                KinanaButton {
                                    text: "10 دقائق";
                                    variant: root.auto_lock_timeout_mins == 10 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(10); }
                                }
                                KinanaButton {
                                    text: "5 دقائق (افتراضي)";
                                    variant: root.auto_lock_timeout_mins == 5 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(5); }
                                }
                                KinanaButton {
                                    text: "دقيقة واحدة";
                                    variant: root.auto_lock_timeout_mins == 1 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(1); }
                                }
                            }

                            // Preset Pills Row 2
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                KinanaButton {
                                    text: "أبداً (تعطيل الإقفال)";
                                    variant: root.auto_lock_timeout_mins == 0 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(0); }
                                }
                                KinanaButton {
                                    text: "ساعة واحدة";
                                    variant: root.auto_lock_timeout_mins == 60 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(60); }
                                }
                                KinanaButton {
                                    text: "30 دقيقة";
                                    variant: root.auto_lock_timeout_mins == 30 ? "primary" : "secondary";
                                    custom-font-size: 12px;
                                    custom-height: 34px;
                                    clicked => { root.set_auto_lock_timeout(30); }
                                }
                            }

                            Text {
                                text: "الحالي: " + root.auto_lock_timeout_mins + " دقيقة";
                                color: #10b981;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    // SECTION 3: MASTER PASSWORD CHANGE (Screenshot 3)
                    Rectangle {
                        border-radius: 16px;
                        background: #111218;
                        border-width: 1px;
                        border-color: #20222e;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                Text {
                                    text: "تغيير رمز الدخول (PIN) أو كلمة المرور الرئيسية";
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Image {
                                    source: @image-url("assets/icons/key.svg");
                                    width: 18px;
                                    height: 18px;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                KinanaInput {
                                    label: "تأكيد الرمز الجديد:";
                                    placeholder: "أعد إدخال الرمز للتأكيد...";
                                    password: true;
                                    text <=> root.change_confirm_pass;
                                }

                                KinanaInput {
                                    label: "الرمز أو كلمة المرور الجديدة:";
                                    placeholder: "أدخل الرمز الجديد...";
                                    password: true;
                                    text <=> root.change_new_pass;
                                }
                            }

                            KinanaInput {
                                label: "كلمة المرور الحالية للتأكيد:";
                                placeholder: "أدخل الرمز الحالي للخزنة...";
                                password: true;
                                text <=> root.change_old_pass;
                            }

                            HorizontalLayout {
                                alignment: end;
                                KinanaButton {
                                    text: "حفظ وتطبيق الرمز الجديد";
                                    variant: "primary";
                                    has-icon: true;
                                    icon: @image-url("assets/icons/check.svg");
                                    custom-height: 42px;
                                    clicked => {
                                        root.change_master_password(
                                            root.change_old_pass,
                                            root.change_new_pass,
                                            root.change_confirm_pass
                                        );
                                    }
                                }
                            }
                        }
                    }

                    // SECTION 4: EMERGENCY RECOVERY KEY (Screenshot 3)
                    Rectangle {
                        border-radius: 16px;
                        background: #111218;
                        border-width: 1px;
                        border-color: #20222e;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                VerticalLayout {
                                    Text {
                                        text: "مفتاح استرداد الطوارئ (Emergency Recovery Key)";
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 700;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: "احفظ هذا المفتاح في مكان آمن. يتيح لك استعادة كامل الخزنة في حال نسيت رمز الدخول!";
                                        color: #94a3b8;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                    }
                                }

                                Image {
                                    source: @image-url("assets/icons/key.svg");
                                    width: 18px;
                                    height: 18px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 50px;
                                border-radius: 12px;
                                background: #181922;
                                border-width: 1px;
                                border-color: #262938;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    KinanaButton {
                                        text: "نسخ المفتاح";
                                        variant: "secondary";
                                        has-icon: true;
                                        icon: @image-url("assets/icons/copy.svg");
                                        custom-font-size: 12px;
                                        custom-height: 34px;
                                        clicked => {
                                            root.copy_to_clipboard(root.emergency_key_display);
                                        }
                                    }

                                    Text {
                                        text: root.emergency_key_display != "" ? root.emergency_key_display : "KN-CHV8-KMTR-9F6Q-AYQ4";
                                        color: #ffffff;
                                        font-size: 15px;
                                        font-weight: 800;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =========================================================================
        // MODAL 5: EMERGENCY RECOVERY MODAL
        // =========================================================================
        if root.show_recovery_modal: KinanaModal {
            title: "استعادة الخزنة عبر مفتاح الطوارئ";
            modal-width: 480px;
            modal-max-height: 480px;
            close => { root.show_recovery_modal = false; }

            VerticalLayout {
                spacing: 16px;

                Text {
                    text: "إذا نسيت كلمة المرور الرئيسية، أدخل مفتاح الطوارئ المكون من 32 حرفاً لتعيين كلمة مرور جديدة:";
                    color: #94a3b8;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: right;
                }

                KinanaInput {
                    label: "مفتاح الطوارئ (32 رمز)";
                    placeholder: "ألصق مفتاح الطوارئ هنا...";
                    text <=> root.recovery_input_key;
                }

                KinanaInput {
                    label: "كلمة المرور الرئيسية الجديدة";
                    placeholder: "أدخل الرمز الجديد...";
                    password: true;
                    text <=> root.recovery_new_pass;
                }

                KinanaInput {
                    label: "تأكيد كلمة المرور الجديدة";
                    placeholder: "أعد إدخال الرمز الجديد...";
                    password: true;
                    text <=> root.recovery_confirm_pass;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    KinanaButton {
                        text: "إلغاء";
                        variant: "ghost";
                        clicked => { root.show_recovery_modal = false; }
                    }

                    KinanaButton {
                        text: "استعادة الخزنة وتعيين الرمز";
                        variant: "primary";
                        clicked => {
                            root.recover_vault(
                                root.recovery_input_key,
                                root.recovery_new_pass,
                                root.recovery_confirm_pass
                            );
                        }
                    }
                }
            }
        }
    }
}
